<style>
  :root{
    --ink:#182420; --ink-soft:#4B5A53; --ink-faint:#7C8A82;
    --paper:#F3F4EF; --surface:#FFFFFF; --surface-2:#EAEBE3;
    --line:#DADCD1; --line-soft:#E7E8E0;
    --accent:#AD7A2E; --accent-ink:#6E4E19; --accent-bg:#F1E4CB;
    --good:#3E7A6C; --good-bg:#E1EEE8; --good-ink:#25473D;
    --warn:#C6892E; --warn-bg:#F5E7CE; --warn-ink:#7A550F;
    --bad:#B14F3E; --bad-bg:#F3E0DA; --bad-ink:#7A2F22;
    --shadow: 0 1px 2px rgba(24,36,32,.06), 0 8px 24px -12px rgba(24,36,32,.18);
    --font-display:'Fraunces',Georgia,'Times New Roman',serif;
    --font-body:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    --font-mono:'IBM Plex Mono',ui-monospace,'SFMono-Regular',Consolas,monospace;
  }
  *{box-sizing:border-box}
  body{background:var(--paper); color:var(--ink); font-family:var(--font-body); font-size:14px; line-height:1.5; margin:0;}
  h1,h2,h3{font-family:var(--font-display); font-weight:600; margin:0;}
  button{font-family:inherit; font-size:inherit; cursor:pointer;}
  input,select,textarea{font-family:inherit; font-size:inherit; color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:9px 11px;}
  input:focus,select:focus,textarea:focus{outline:2px solid var(--accent); outline-offset:1px;}
  table{border-collapse:collapse; width:100%;}
  .tabular{font-variant-numeric:tabular-nums;}

  #app{max-width:1180px; margin:0 auto; padding:22px 16px 64px;}
  .topbar{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px; padding-bottom:16px; border-bottom:1px solid var(--line);}
  .brand{display:flex; align-items:baseline; gap:10px;}
  .brand h1{font-size:22px; letter-spacing:-.01em;}
  .brand .sub{color:var(--ink-faint); font-size:12.5px;}
  .whoami{color:var(--ink-faint); font-size:12px;}
  .tabs{display:flex; gap:4px; background:var(--surface-2); padding:4px; border-radius:10px;}
  .tab-btn{border:none; background:transparent; padding:8px 16px; border-radius:7px; color:var(--ink-soft); font-weight:500;}
  .tab-btn.active{background:var(--surface); color:var(--ink); box-shadow:var(--shadow);}
  .tab-btn[disabled]{opacity:.4; cursor:not-allowed;}
  .view{display:none;} .view.active{display:block;}

  .card{background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow);}
  .form-card{padding:26px; max-width:760px; margin:0 auto;}
  .form-head{margin-bottom:22px;}
  .form-head h2{font-size:20px;}
  .form-head p{color:var(--ink-soft); margin:6px 0 0; font-size:13px;}

  .field{margin-bottom:16px;}
  .field label{display:block; font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:6px; text-transform:uppercase; letter-spacing:.03em;}
  .field input[type=text], .field input[type=email], .field input[type=tel], .field input[type=date], .field textarea{width:100%;}
  .field textarea{min-height:64px; resize:vertical;}
  .row{display:grid; gap:14px; grid-template-columns:1fr 1fr;}
  .row3{display:grid; gap:14px; grid-template-columns:1fr 1fr 1fr;}
  @media (max-width:620px){ .row,.row3{grid-template-columns:1fr;} }
  .section-title{font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--accent-ink); font-weight:700; margin:26px 0 12px; padding-top:14px; border-top:1px solid var(--line-soft);}
  .section-title:first-of-type{border-top:none; margin-top:4px; padding-top:0;}

  .choice-group{display:flex; flex-wrap:wrap; gap:8px;}
  .choice{border:1px solid var(--line); background:var(--surface); padding:8px 14px; border-radius:20px; color:var(--ink-soft); font-weight:500; font-size:13px;}
  .choice.selected{background:var(--ink); border-color:var(--ink); color:var(--paper);}
  .choice.selected.si{background:var(--good); border-color:var(--good); color:#fff;}
  .choice.selected.no{background:var(--surface-2); border-color:var(--line); color:var(--ink-soft);}
  .other-input{margin-top:8px;}

  .btn{display:inline-flex; align-items:center; gap:8px; border:1px solid var(--ink); background:var(--ink); color:var(--paper); padding:10px 18px; border-radius:9px; font-weight:600;}
  .btn.secondary{background:transparent; color:var(--ink); border-color:var(--line);}
  .btn.accent{background:var(--accent); border-color:var(--accent); color:#211605;}
  .btn.danger{background:transparent; border-color:var(--bad); color:var(--bad);}
  .btn:disabled{opacity:.5; cursor:default;}
  .btn-row{display:flex; gap:10px; margin-top:22px; align-items:center;}
  .toast{position:fixed; bottom:22px; left:50%; transform:translateX(-50%); background:var(--ink); color:var(--paper); padding:11px 20px; border-radius:9px; font-size:13.5px; box-shadow:var(--shadow); opacity:0; pointer-events:none; transition:.25s; z-index:60;}
  .toast.show{opacity:1; transform:translate(-50%,-4px);}

  .stats{display:grid; grid-template-columns:repeat(6,1fr); gap:10px; margin-bottom:18px;}
  @media (max-width:900px){ .stats{grid-template-columns:repeat(3,1fr);} }
  @media (max-width:520px){ .stats{grid-template-columns:repeat(2,1fr);} }
  .stat{background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:14px 16px;}
  .stat .n{font-family:var(--font-mono); font-size:22px; font-weight:500;}
  .stat .l{color:var(--ink-faint); font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; margin-top:2px;}

  .toolbar{display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:14px;}
  .toolbar input[type=search]{min-width:200px; flex:1;}
  .toolbar select{max-width:170px;}
  .spacer{flex:1;}

  .table-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:12px; background:var(--surface);}
  th,td{text-align:left; padding:10px 13px; border-bottom:1px solid var(--line-soft); white-space:nowrap; font-size:13px;}
  th{color:var(--ink-faint); font-weight:600; text-transform:uppercase; font-size:10.5px; letter-spacing:.04em; background:var(--surface-2);}
  tbody tr{cursor:pointer;}
  tbody tr:hover{background:var(--surface-2);}
  .empty-row td{color:var(--ink-faint); cursor:default; text-align:center; padding:30px;}

  .pill{display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:600;}
  .pill.good{background:var(--good-bg); color:var(--good-ink);}
  .pill.warn{background:var(--warn-bg); color:var(--warn-ink);}
  .pill.bad{background:var(--bad-bg); color:var(--bad-ink);}
  .pill.neutral{background:var(--surface-2); color:var(--ink-faint);}
  .pill.clickable{cursor:pointer; text-decoration:underline; text-underline-offset:2px;}

  .drawer-backdrop{position:fixed; inset:0; background:rgba(10,14,12,.4); opacity:0; pointer-events:none; transition:.2s; z-index:40;}
  .drawer-backdrop.show{opacity:1; pointer-events:auto;}
  .drawer{position:fixed; top:0; right:0; bottom:0; width:min(480px,100%); background:var(--surface); box-shadow:-10px 0 30px rgba(0,0,0,.15); transform:translateX(100%); transition:.25s; z-index:41; display:flex; flex-direction:column;}
  .drawer.show{transform:translateX(0);}
  .drawer-head{padding:20px 22px; border-bottom:1px solid var(--line); display:flex; align-items:flex-start; justify-content:space-between; gap:10px;}
  .drawer-head h3{font-size:19px;}
  .drawer-body{padding:20px 22px; overflow-y:auto; flex:1;}
  .close-x{border:none; background:var(--surface-2); width:30px; height:30px; border-radius:50%; color:var(--ink-soft); font-size:16px; flex:none;}
  .kv{display:grid; grid-template-columns:120px 1fr; gap:6px 12px; font-size:13px; margin-bottom:3px;}
  .kv dt{color:var(--ink-faint);} .kv dd{margin:0;}
  .detail-section{margin-bottom:20px;}
  .detail-section h4{font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--accent-ink); margin-bottom:8px; font-weight:700;}
  .quick-actions{display:flex; gap:8px; margin-top:14px;}
  .quick-actions a{flex:1; text-align:center; text-decoration:none; padding:9px; border-radius:8px; border:1px solid var(--line); color:var(--ink); font-size:13px; font-weight:600;}
  .log-entry{border-left:2px solid var(--line); padding:2px 0 10px 12px; margin-bottom:2px;}
  .log-entry .meta{font-size:11px; color:var(--ink-faint); margin-bottom:2px;}
  .log-entry .txt{font-size:13px;}
  .log-add{display:flex; gap:8px; margin-top:10px;}
  .log-add textarea{flex:1; min-height:40px;}

  .modal-backdrop{position:fixed; inset:0; background:rgba(10,14,12,.45); display:none; align-items:center; justify-content:center; z-index:50; padding:16px;}
  .modal-backdrop.show{display:flex;}
  .modal{background:var(--surface); border-radius:14px; max-width:640px; width:100%; max-height:88vh; overflow-y:auto; box-shadow:var(--shadow);}
  .modal-head{padding:20px 24px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:flex-start;}
  .modal-body{padding:20px 24px;}
  .ledger-total{font-family:var(--font-mono); font-size:20px; font-weight:500;}

  .empty-state{text-align:center; padding:60px 20px; color:var(--ink-faint);}
  .empty-state h3{color:var(--ink); margin-bottom:6px;}
  .note{font-size:12px; color:var(--ink-faint); margin-top:6px;}
  .locked{max-width:480px; margin:60px auto; text-align:center; padding:30px;}
</style>
